include archivist.py README.md CHANGELOG.md LICENSE THIRD-PARTY.md START-HERE.txt
include CONTRIBUTING.md SECURITY.md pyproject.toml
include requirements-dev.txt
recursive-include source *.py *.html *.css *.js
